---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Finder" },
  { href: "/lookup/", label: "Lookup" },
  { href: "/brands/", label: "Brands" },
  { href: "/pellet-stoves/", label: "Pellet" },
  { href: "/tools/stove-size-calculator/", label: "Size" },
  { href: "/tools/heating-cost-calculator/", label: "Cost" },
];
function current(href) {
  return path === href || (href !== "/" && path.startsWith(href));
}
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href="/" aria-label="StoveRatings home">
      <svg class="mark" width="32" height="32" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="var(--charcoal)"></rect>
        <rect x="12" y="34" width="10" height="18" rx="3" fill="var(--ember)"></rect>
        <rect x="27" y="24" width="10" height="28" rx="3" fill="var(--ember-mid)"></rect>
        <rect x="42" y="14" width="10" height="38" rx="3" fill="var(--paper)"></rect>
      </svg>
      <span class="brand-text">
        <span class="brand-name">StoveRatings</span>
        <span class="tagline">EPA test numbers — not scores</span>
      </span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
