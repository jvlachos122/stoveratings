---
import { catalog } from "../lib/catalog.js";

const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Finder" },
  { href: "/lookup/", label: "Lookup" },
  { href: "/brands/", label: "Brands" },
  { href: "/pellet-stoves/", label: "Pellet" },
  { href: "/tools/stove-size-calculator/", label: "Size" },
];
function current(href) {
  return path === href || (href !== "/" && path.startsWith(href));
}
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href="/" aria-label="StoveRatings home">
      <svg class="mark" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
        <rect x="1" y="1" width="30" height="30" fill="#F5F1EA" stroke="#1E1C1A" stroke-width="2"></rect>
        <rect x="7" y="8" width="18" height="14" fill="#1E1C1A"></rect>
        <rect x="11" y="12" width="10" height="6" fill="#B4441F"></rect>
        <circle cx="6" cy="6" r="1.3" fill="#1E1C1A"></circle>
        <circle cx="26" cy="6" r="1.3" fill="#1E1C1A"></circle>
        <circle cx="6" cy="26" r="1.3" fill="#1E1C1A"></circle>
        <circle cx="26" cy="26" r="1.3" fill="#1E1C1A"></circle>
      </svg>
      StoveRatings
    </a>
    <p class="snapshot">EPA snapshot {catalog.meta.snapshotDate}</p>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
