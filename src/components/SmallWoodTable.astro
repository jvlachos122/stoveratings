---
import { smallWoodRowView } from "../lib/small-wood-stoves.js";

const { rows = [], caption } = Astro.props;
---

<div class="table-wrap">
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col"><a href="/glossary/#model-line">Model line</a></th>
        <th scope="col"><a href="/glossary/#epa-manufacturer">EPA manufacturer</a></th>
        <th scope="col" class="num"><a href="/glossary/#firebox-volume">Firebox (cu ft)</a></th>
        <th scope="col" class="num"><a href="/glossary/#btu-hr">Heat output (BTU/hr)</a></th>
        <th scope="col" class="num"><a href="/glossary/#g-hr">Emission (g/hr)</a></th>
        <th scope="col" class="num"><a href="/glossary/#hhv">HHV efficiency</a></th>
        <th scope="col"><a href="/glossary/#epa-subtype">Catalytic, non-catalytic, or hybrid</a></th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => {
        const view = smallWoodRowView(row);
        return (
          <tr>
            <th scope="row">
              <a href={view.href}>{view.model}</a>
              {view.insert ? <div class="small">Name indicates insert</div> : null}
            </th>
            <td>{view.manufacturer}</td>
            <td class="num">{view.firebox}</td>
            <td class="num">{view.heat}</td>
            <td class="num">{view.emission}</td>
            <td class="num">{view.efficiency}</td>
            <td>{view.subtype}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
