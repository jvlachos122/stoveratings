---
import { emissionUnitShort, fireboxText, formatNumber, heatText, statusLabel } from "../lib/format.js";

const { stoves = [], caption, showManufacturer = true } = Astro.props;
const unit = stoves[0]?.emissionUnit || "g/hr";
const emissionHref = unit === "lb/mmBTU" ? "/glossary/#lb-mmbtu" : "/glossary/#g-hr";
---

<div class="table-wrap">
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col"><a href="/glossary/#model-line">Model line</a></th>
        {showManufacturer ? <th scope="col"><a href="/glossary/#epa-manufacturer">EPA manufacturer</a></th> : null}
        <th scope="col"><a href="/glossary/#currently-certified">Status</a></th>
        <th scope="col" class="num"><a href={emissionHref}>Emission ({emissionUnitShort(unit)})</a></th>
        <th scope="col" class="num"><a href="/glossary/#hhv">HHV efficiency</a></th>
        <th scope="col" class="num"><a href="/glossary/#btu-hr">Heat output</a></th>
        <th scope="col" class="num"><a href="/glossary/#firebox-volume">Firebox</a></th>
        <th scope="col"><a href="/glossary/#certified-fuel">Fuel</a></th>
      </tr>
    </thead>
    <tbody>
      {
        stoves.map((stove) => (
          <tr>
            <th scope="row">
              <a href={stove.url}>{stove.model}</a>
              {stove.insertFlag ? <div class="small">Name indicates insert</div> : null}
            </th>
            {showManufacturer ? <td>{stove.manufacturer || "Not listed"}</td> : null}
            <td>
              <span class:list={["pill", stove.current ? "pill-current" : "pill-previous"]}>{statusLabel(stove.current)}</span>
            </td>
            <td class="num">{stove.emission == null ? "Not listed" : formatNumber(stove.emission, 3)}</td>
            <td class="num">{stove.efficiency == null ? "Not listed" : `${formatNumber(stove.efficiency, 2)}%`}</td>
            <td class="num">{heatText(stove)}</td>
            <td class="num">{fireboxText(stove)}</td>
            <td>{stove.fuel || "Not listed"}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
