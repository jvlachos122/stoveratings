---
import { logoxNote } from "../lib/affiliates.js";

const note = logoxNote(Astro.props.path);
---

{note ? (
  <div class="affiliate-note" data-affiliate="logox">
    <p><a href={note.href} rel={note.rel}>{note.label}</a></p>
    <p class="affiliate-disclosure">{note.disclosure}</p>
  </div>
) : null}
