---

<section id="finder" aria-labelledby="finder-heading">
  <h2 id="finder-heading">Certified stove finder</h2>
  <p class="muted">
    Filter the model lines in this snapshot. The table starts with models EPA listed as currently certified.
    Previously certified models load when you ask for them. Figures are EPA's.
  </p>
  <div class="filters">
    <label>Search
      <input id="finder-q" type="search" placeholder="Model, brand, or manufacturer">
    </label>
    <label>Type
      <select id="finder-type">
        <option value="">Any</option>
      </select>
    </label>
    <label>Subtype
      <select id="finder-subtype">
        <option value="">Any</option>
      </select>
    </label>
    <label>Fuel
      <select id="finder-fuel">
        <option value="">Any</option>
      </select>
    </label>
    <label>Emission at or below
      <input id="finder-emission" type="number" min="0" step="0.01" inputmode="decimal">
    </label>
    <label>HHV efficiency at or above
      <input id="finder-efficiency" type="number" min="0" max="100" step="0.1" inputmode="decimal">
    </label>
    <label>Sort
      <select id="finder-sort">
        <option value="emission">Emission, lowest first</option>
        <option value="efficiency">HHV efficiency, highest first</option>
        <option value="btu">Heat output, highest first</option>
        <option value="name">Model name</option>
      </select>
    </label>
    <label class="check">
      <input id="finder-previous" type="checkbox">
      Include previously certified
    </label>
  </div>
  <p id="finder-status" class="small" aria-live="polite">Loading the current snapshot…</p>
  <div class="table-wrap">
    <table>
      <caption>EPA model lines matching the filters</caption>
      <thead>
        <tr>
          <th scope="col">Model line</th>
          <th scope="col">EPA manufacturer</th>
          <th scope="col">Status</th>
          <th scope="col" class="num">Emission</th>
          <th scope="col" class="num">HHV %</th>
          <th scope="col" class="num">Heat output (BTU/hr)</th>
        </tr>
      </thead>
      <tbody id="finder-rows"></tbody>
    </table>
  </div>
  <noscript>
    <p>The filter runs in your browser. The lists linked from this page are plain HTML tables of the same snapshot.</p>
  </noscript>
</section>
<script src="/scripts/finder.js" defer></script>
