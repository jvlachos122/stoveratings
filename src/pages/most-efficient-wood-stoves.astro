---
import Answer from "../components/Answer.astro";
import DataNote from "../components/DataNote.astro";
import EfficiencyFinder from "../components/EfficiencyFinder.astro";
import Base from "../layouts/Base.astro";
import { catalog } from "../lib/catalog.js";
import {
  efficiencyFinderNotes,
  efficiencyFinderSentences,
  efficiencyFlags,
  efficiencyRows,
} from "../lib/efficiency-finder.js";
import { metaDescription } from "../lib/format.js";
import { articleLd, webAppLd } from "../lib/schema.js";

const date = catalog.meta.snapshotDate;
const rows = efficiencyRows(catalog.stoves);
const flags = efficiencyFlags(rows);
const sentences = efficiencyFinderSentences(catalog.stoves, date);
const notes = efficiencyFinderNotes();
const description = metaDescription(sentences);
const toolName = "Wood stove HHV efficiency filters";
---

<Base title="Highest HHV efficiency wood stoves" description={description} breadcrumbs={[{ href: "/", label: "Home" }, { href: "/most-efficient-wood-stoves/", label: "Highest HHV efficiency" }]} jsonLd={[articleLd("Wood stoves ordered by EPA HHV efficiency", description, "/most-efficient-wood-stoves/", date), webAppLd(toolName, description, "/most-efficient-wood-stoves/")]}>
  <div class="wrap">
    <h1>Wood stoves with the highest EPA HHV efficiency</h1>
    <Answer sentences={sentences} />
    <p>
      <a href="/tools/stove-size-calculator/">Fits my space</a>
      is the stove size calculator: it compares a planning BTU/hr range with the heat output EPA listed.
      The <a href="/tools/firebox-log-length/">firebox and log length</a> page does not turn a cubic-foot volume into a piece length.
    </p>
    <EfficiencyFinder rows={rows} flags={flags} />
    <p>Pellet stoves are ordered separately on <a href="/most-efficient-pellet-stoves/">the pellet efficiency list</a>.</p>
    <DataNote items={notes} />
  </div>
</Base>
