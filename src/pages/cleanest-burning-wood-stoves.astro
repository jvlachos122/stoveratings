---
import Answer from "../components/Answer.astro";
import DataNote from "../components/DataNote.astro";
import EmissionFinder from "../components/EmissionFinder.astro";
import Base from "../layouts/Base.astro";
import { catalog } from "../lib/catalog.js";
import {
  emissionFinderSentences,
  emissionFlags,
  emissionListNotes,
  emissionListTitle,
  emissionMetaDescription,
  emissionRows,
} from "../lib/emission-finder.js";
import { articleLd, webAppLd } from "../lib/schema.js";

const date = catalog.meta.snapshotDate;
const rows = emissionRows(catalog.stoves);
const flags = emissionFlags(rows);
const sentences = emissionFinderSentences(catalog.stoves, date);
const notes = emissionListNotes(catalog.stoves);
const description = emissionMetaDescription(catalog.stoves, date);
const title = emissionListTitle(rows);
const toolName = "Wood stove emission rate filters";
---

<Base title={title} description={description} breadcrumbs={[{ href: "/", label: "Home" }, { href: "/cleanest-burning-wood-stoves/", label: "Lowest emission rates" }]} jsonLd={[articleLd("Wood stoves ordered by EPA emission rate", description, "/cleanest-burning-wood-stoves/", date), webAppLd(toolName, description, "/cleanest-burning-wood-stoves/")]}>
  <div class="wrap">
    <h1>Wood stoves with the lowest EPA emission rates</h1>
    <Answer sentences={sentences} />
    <p>
      <a href="/tools/stove-size-calculator/">Fits my space</a>
      compares a planning BTU/hr range with the heat output EPA listed.
      The <a href="/tools/firebox-log-length/">firebox and log length</a> page does not turn a cubic-foot volume into a piece length.
    </p>
    <EmissionFinder rows={rows} flags={flags} />
    <p>Pellet stoves are ordered separately on <a href="/cleanest-burning-pellet-stoves/">the pellet emission list</a>.</p>
    <DataNote items={notes} />
  </div>
</Base>
