---
import Answer from "../../components/Answer.astro";
import DataNote from "../../components/DataNote.astro";
import StoveTable from "../../components/StoveTable.astro";
import Base from "../../layouts/Base.astro";
import { brandAnswer, brandProse } from "../../lib/brand-copy.js";
import { catalog, stovesForBrand } from "../../lib/catalog.js";
import { metaDescription, pageTitle } from "../../lib/format.js";
import { datasetLd } from "../../lib/schema.js";

export function getStaticPaths() {
  const hubs = catalog.brands.map((brand) => ({
    params: { brand: brand.slug },
    props: { brand, redirect: null },
  }));
  const moved = catalog.redirects.map((redirect) => ({
    params: { brand: redirect.fromSlug },
    props: { brand: null, redirect },
  }));
  return [...hubs, ...moved];
}

const { brand, redirect } = Astro.props;
const target = redirect ? catalog.brandBySlug.get(redirect.toSlug) : null;
const lines = brand ? stovesForBrand(brand.slug) : [];
const sentences = redirect
  ? [
      `EPA's manufacturer string ${redirect.fromName} is grouped on the ${target.name} hub.`,
      "This address is the previous URL for that grouping.",
      `Source: EPA Certified Wood Heater Database, snapshot ${catalog.meta.snapshotDate}.`,
    ]
  : brandAnswer(brand, lines, catalog.meta.snapshotDate);
const prose = brand ? brandProse(brand, lines) : [];
const description = metaDescription(sentences);
const current = lines.filter((stove) => stove.current);
const previous = lines.filter((stove) => !stove.current);
const insertLines = lines.filter((stove) => stove.insertFlag);
const insertCurrent = insertLines.filter((stove) => stove.current).length;
const insertWood = insertLines.some((stove) => stove.type === "Wood Stove");
const insertPellet = insertLines.some((stove) => stove.type === "Pellet Stove");
const crumbs = redirect
  ? [
      { href: "/", label: "Home" },
      { href: "/brands/", label: "Brands" },
      { href: redirect.url, label: redirect.fromName },
    ]
  : [
      { href: "/", label: "Home" },
      { href: "/brands/", label: "Brands" },
      { href: brand.url, label: brand.name },
    ];
---

{
  redirect ? (
    <Base
      title={pageTitle(`${redirect.fromName} moved`)}
      description={description}
      noindex={true}
      canonicalPath={redirect.targetUrl}
      refreshPath={redirect.targetUrl}
      breadcrumbs={crumbs}
    >
      <div class="wrap">
        <h1>{redirect.fromName} is listed on the {target.name} hub</h1>
        <Answer sentences={sentences} />
        <p>
          <a href={redirect.targetUrl}>{target.name}</a>
        </p>
        <p>{target.note}</p>
        <p class="small">Evidence used for this hub: {target.evidence}</p>
        <p>
          <a href={catalog.meta.sourceUrl}>EPA Certified Wood Heater Database</a>
        </p>
      </div>
    </Base>
  ) : (
    <Base title={pageTitle(brand.name)} description={description} breadcrumbs={crumbs} jsonLd={[datasetLd(catalog.meta)]}>
      <div class="wrap">
        <h1>{brand.name}</h1>
        <Answer sentences={sentences} />
        {
          prose.length ? (
            <div class="prose">
              <h2 id="listed-figures">Figures EPA lists</h2>
              {prose.map((sentence) => <p>{sentence}</p>)}
            </div>
          ) : null
        }
        <p>{brand.note}</p>
        <p class="small">Evidence used for this hub: {brand.evidence}</p>
        {
          brand.manufacturers.length ? (
            <p>
              EPA manufacturer {brand.manufacturers.length === 1 ? "string" : "strings"}:
              {" "}
              {brand.manufacturers.map((name) => name || "blank cell").join("; ")}.
            </p>
          ) : null
        }
        {
          insertLines.length ? (
            <p>
              EPA lists {insertLines.length} model {insertLines.length === 1 ? "line" : "lines"} on this hub with the label name indicates insert ({insertCurrent} currently certified).
              {" "}
              See {insertWood ? <a href="/wood-stove-inserts/">wood stove inserts</a> : null}
              {insertWood && insertPellet ? " and " : null}
              {insertPellet ? <a href="/pellet-stove-inserts/">pellet stove inserts</a> : null}.
            </p>
          ) : null
        }
        <h2 id="current">Currently certified</h2>
        {
          current.length ? (
            <StoveTable stoves={current} caption={`${brand.name}: model lines EPA lists as currently certified`} />
          ) : (
            <p>EPA does not list a currently certified model line on this hub in the {catalog.meta.snapshotDate} snapshot.</p>
          )
        }
        <h2 id="previous">Previously certified</h2>
        {
          previous.length ? (
            <StoveTable stoves={previous} caption={`${brand.name}: model lines not in the currently certified result`} />
          ) : (
            <p>Every model line on this hub is in the currently certified result.</p>
          )
        }
        <DataNote
          items={[
            brand.role === "alias"
              ? "This is not the EPA manufacturer field. A row is here because the brand name is in the EPA text cited above."
              : "The hub title follows the EPA manufacturer string, or the shared name when several strings contain it.",
            "Counts in the answer are model lines. A model line can contain more than one EPA test row; the model page shows each row.",
            "Blank emission and HHV efficiency cells are not listed by EPA. They are not zeros. A median uses only the rows that list the figure, and the n beside it is that row count. An even count is the average of the two middle values.",
          ]}
        />
        <p>
          <a href={catalog.meta.sourceUrl}>EPA Certified Wood Heater Database</a>
        </p>
      </div>
    </Base>
  )
}
