---
import Base from "../layouts/Base.astro";
import { disclosureView } from "../lib/affiliates.js";
import { site } from "../lib/site.js";

const view = disclosureView();
const description = view.description;
---

<Base title="Disclosure" description={description} breadcrumbs={[{ href: "/", label: "Home" }, { href: "/disclosure/", label: "Disclosure" }]}>
  <div class="wrap prose">
    <h1>Disclosure</h1>
    <p>StoveRatings is operated by {site.legalName}.</p>
    {view.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    {view.placements.length ? (
      <ul>
        {view.placements.map((item) => (
          <li><a href={item.path}>{item.label}</a>{` links to ${item.destination}.`}</li>
        ))}
      </ul>
    ) : null}
  </div>
</Base>
