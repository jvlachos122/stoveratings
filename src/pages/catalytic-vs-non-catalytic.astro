---
import Answer from "../components/Answer.astro";
import DataNote from "../components/DataNote.astro";
import SubtypeTable from "../components/SubtypeTable.astro";
import Base from "../layouts/Base.astro";
import { catalog } from "../lib/catalog.js";
import { metaDescription } from "../lib/format.js";
import { articleLd, faqLd } from "../lib/schema.js";
import {
  assertSubtypeCopy,
  catalyticHybridCopy,
  labelParagraph,
  roomTableLead,
  pelletTableLead,
  subtypeAnswer,
  subtypeDataNotes,
  subtypeFaqs,
  subtypeMixedLines,
  subtypeNameMismatches,
  NOT_LISTED_BY_EPA,
  subtypeReport,
  technologyCopy,
  woodTableLead,
} from "../lib/subtype-explain.js";

const date = catalog.meta.snapshotDate;
const report = subtypeReport(catalog.stoves);
const mismatches = subtypeNameMismatches(catalog.stoves);
const mixed = subtypeMixedLines(catalog.stoves);
const sentences = subtypeAnswer(report, date);
const faqs = subtypeFaqs(report, mismatches, mixed, date);
const notes = subtypeDataNotes();
const tech = technologyCopy();
const older = catalyticHybridCopy();
const description = metaDescription(sentences);
assertSubtypeCopy([
  sentences.join(" "),
  labelParagraph(report, date),
  roomTableLead(report),
  woodTableLead(),
  pelletTableLead(),
  tech.before,
  tech.linkLabel,
  tech.after,
  older.before,
  older.linkLabel,
  older.after,
  faqs.map((faq) => `${faq.question} ${faq.answer}`).join(" "),
  notes.join(" "),
].join(" "));
---

<Base title="Catalytic, non-catalytic, and hybrid" description={description} breadcrumbs={[{ href: "/", label: "Home" }, { href: "/catalytic-vs-non-catalytic/", label: "Catalytic, non-catalytic, and hybrid" }]} jsonLd={[articleLd("Catalytic, non-catalytic, and hybrid EPA subtypes", description, "/catalytic-vs-non-catalytic/", date), faqLd(faqs)]}>
  <div class="wrap">
    <div class="prose">
      <h1>Catalytic, non-catalytic, and hybrid</h1>
      <Answer sentences={sentences} />
      <p>{labelParagraph(report, date)}</p>
      <h2>Currently certified room-heater rows</h2>
      <p>{roomTableLead(report)}</p>
    </div>
    <SubtypeTable blocks={report.all} split caption="Currently certified room-heater rows by EPA subtype, including wood stoves and pellet stoves" />
    <SubtypeTable blocks={report.all} mode="range" caption="Lowest and highest listed emission rate and HHV efficiency on those room-heater rows" />
    <div class="prose">
      <h2>Wood-stove rows</h2>
      <p>{woodTableLead()}</p>
    </div>
    <SubtypeTable blocks={report.wood} caption="Currently certified wood-stove rows by EPA subtype" />
    <SubtypeTable blocks={report.wood} mode="range" caption="Lowest and highest listed emission rate and HHV efficiency on those wood-stove rows" />
    <div class="prose">
      <h2>Pellet-stove rows</h2>
      <p>{pelletTableLead()}</p>
    </div>
    <SubtypeTable blocks={report.pellet} caption="Currently certified pellet-stove rows by EPA subtype" />
    <SubtypeTable blocks={report.pellet} mode="range" caption="Lowest and highest listed emission rate and HHV efficiency on those pellet-stove rows" />
    <div class="prose">
    <p>
      Wood-stove lists for one subtype:
      <a href="/catalytic-wood-stoves/">catalytic wood stoves</a>,
      <a href="/non-catalytic-wood-stoves/">non-catalytic wood stoves</a>,
      and <a href="/hybrid-wood-stoves/">hybrid wood stoves</a>.
      Ordered lists name the EPA field they sort:
      <a href="/most-efficient-wood-stoves/">wood stoves ordered by HHV efficiency</a>,
      <a href="/cleanest-burning-wood-stoves/">wood stoves ordered by emission rate</a>,
      and <a href="/most-efficient-pellet-stoves/">pellet stoves ordered by HHV efficiency</a>.
      Pellet stoves of every subtype are on <a href="/pellet-stoves/">the pellet stove list</a>.
    </p>
    <h2>What the labels mean</h2>
    <p>{tech.before}<a href={tech.href}>{tech.linkLabel}</a>{tech.after}</p>
    <p>{older.before}<a href={older.href}>{older.linkLabel}</a>{older.after}</p>
    <h2>The model name is not the subtype</h2>
    <p>The EPA model cell and the EPA subtype cell are different fields. A model line can contain the word hybrid when the subtype is Catalytic Stove or Non-Catalytic Stove.</p>
    {mismatches.length ? (
      <div class="table-wrap">
        <table>
          <caption>Currently certified room-heater model lines whose model cell contains hybrid and whose subtype is not Hybrid</caption>
          <thead>
            <tr>
              <th scope="col">Model line</th>
              <th scope="col">EPA manufacturer</th>
              <th scope="col">EPA type</th>
              <th scope="col">EPA subtype</th>
            </tr>
          </thead>
          <tbody>
            {mismatches.map((item) => (
              <tr>
                <th scope="row"><a href={item.url}>{item.model}</a></th>
                <td>
                  {item.brandUrl && item.manufacturer !== NOT_LISTED_BY_EPA
                    ? <a href={item.brandUrl}>{item.manufacturer}</a>
                    : item.manufacturer}
                </td>
                <td>{item.type}</td>
                <td>{item.subtypeLabel}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : <p>No currently certified room-heater model line in this snapshot has hybrid in the model cell and a subtype other than Hybrid.</p>}
    {mixed.length ? (
      <p>
        {mixed.map((line, index) => (
          <>
            {index ? ", " : ""}
            <a href={line.url}>{line.model}</a>
          </>
        ))}
        {mixed.length === 1
          ? " is the model line with test rows that do not share one subtype."
          : " are the model lines with test rows that do not share one subtype."}
      </p>
    ) : null}
    {faqs.map((faq) => (
      <section>
        <h2>{faq.question}</h2>
        <p>{faq.answer}</p>
      </section>
    ))}
    <h2>Sources</h2>
    <ul>
      <li><a href={catalog.meta.sourceUrl}>EPA Certified Wood Heater Database</a>, snapshot {date}</li>
      <li><a href={tech.href}>{tech.linkLabel}</a></li>
      <li><a href={older.href}>March 15, 2013 list review on the methodology page</a></li>
    </ul>
    <DataNote items={notes} />
    </div>
  </div>
</Base>
