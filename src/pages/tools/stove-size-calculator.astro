---
import Answer from "../../components/Answer.astro";
import DataNote from "../../components/DataNote.astro";
import Base from "../../layouts/Base.astro";
import { catalog } from "../../lib/catalog.js";
import { formatCount, metaDescription } from "../../lib/format.js";
import { faqLd, webAppLd } from "../../lib/schema.js";
import {
  COMMON_SIZES,
  EXAMPLE_SQFT,
  SIZE_BANDS,
  SIZE_TABLE_CAPTION,
  bandById,
  bandNote,
  commonSizeRows,
  exampleAnswer,
  excludedHeatCount,
  excludedSentence,
  isSizingModel,
  overlapCaption,
  overlapModels,
  overlapRowView,
  overlapStatus,
  planningRange,
  planningSentence,
  planningSpan,
  sizeAnchor,
  sizeFaqs,
} from "../../lib/stove-size.js";

const date = catalog.meta.snapshotDate;
const exampleBand = bandById("moderate");
const exampleRange = planningRange(EXAMPLE_SQFT, exampleBand);
const exampleRows = overlapModels(catalog.stoves, exampleRange.low, exampleRange.high);
const excluded = excludedHeatCount(catalog.stoves);
const hasInserts = catalog.stoves.some((stove) => isSizingModel(stove) && stove.insertFlag);
const sizeRows = commonSizeRows(catalog.stoves);
const sentences = exampleAnswer(catalog.stoves, date);
const faqs = sizeFaqs(catalog.stoves, date);
const description = metaDescription(sentences);
const bandCount = SIZE_BANDS.length;
---

<Base title="Stove size calculator" description={description} breadcrumbs={[{ href: "/", label: "Home" }, { href: "/tools/stove-size-calculator/", label: "Stove size calculator" }]} jsonLd={[webAppLd("Stove size calculator", description, "/tools/stove-size-calculator/"), faqLd(faqs)]}>
  <div class="wrap">
    <h1>Stove size calculator</h1>
    <Answer sentences={sentences} />
    <form id="size-form">
      <div class="filters">
        <label>Heated floor area (square feet)
          <input id="sqft" name="sqft" type="number" min="1" max="20000" value="2000" inputmode="numeric" required>
        </label>
        <label>Planning band
          <select id="climate" name="climate">
            {SIZE_BANDS.map((band) => (
              <option value={band.id} selected={band.id === "moderate"}>{band.label}, {band.low}–{band.high} BTU/hr per sq ft</option>
            ))}
          </select>
        </label>
      </div>
      <button type="submit">Calculate</button>
    </form>
    <p id="size-result" class="result" aria-live="polite">{planningSentence(EXAMPLE_SQFT, exampleBand)}</p>
    <h2>Models whose EPA heat output overlaps</h2>
    <p>EPA heat output is a lab test range, not delivered room heat. A model line is listed when its EPA low and high overlap the planning range. That overlap is a starting list, not a recommendation or a sizing guarantee.</p>
    <p>The list is currently certified model lines whose EPA type is Wood Stove or Pellet Stove, from the {date} snapshot saved on this site. <a href="/wood-furnaces/">Forced-air furnaces</a>, <a href="/outdoor-wood-boilers/">hydronic heaters</a>, and <a href="/pellet-boilers/">pellet boilers</a> are not in this list.</p>
    <div class="filters">
      <label>Type
        <select id="size-type">
          <option value="all" selected>Wood and pellet</option>
          <option value="wood">Wood stoves</option>
          <option value="pellet">Pellet stoves</option>
        </select>
      </label>
      {hasInserts ? (
        <label class="check">
          <input id="size-inserts" type="checkbox">
          Inserts only (the model name indicates an insert)
        </label>
      ) : null}
    </div>
    <p id="overlap-status">{overlapStatus(exampleRows.length, exampleRange)}</p>
    <p id="overlap-excluded">{excludedSentence(excluded)}</p>
    <div class="table-wrap">
      <table id="overlap-table">
        <caption id="overlap-caption">{overlapCaption(EXAMPLE_SQFT, exampleBand)}</caption>
        <thead>
          <tr>
            <th scope="col">Model line</th>
            <th scope="col">Manufacturer</th>
            <th scope="col">Type</th>
            <th scope="col" class="num">EPA heat output</th>
            <th scope="col" class="num">HHV efficiency</th>
            <th scope="col" class="num">Emission rate</th>
          </tr>
        </thead>
        <tbody id="overlap-rows">
          {exampleRows.length ? exampleRows.map((stove) => {
            const view = overlapRowView(stove);
            return (
              <tr>
                <th scope="row">
                  <a href={view.href}>{view.model}</a>
                  {view.insert ? <div class="small">Name indicates insert</div> : null}
                </th>
                <td>{view.manufacturer}</td>
                <td>{view.type}</td>
                <td class="num">{view.heat}</td>
                <td class="num">{view.efficiency}</td>
                <td class="num">{view.emission}</td>
              </tr>
            );
          }) : (
            <tr>
              <td colspan="6">No currently certified wood-stove or pellet-stove model line lists a heat-output range that overlaps this planning range.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
    <noscript>
      <p>The type filter runs in the page script. Without that script, the table above stays on the 2,000 sq ft moderate example. The common-size table below is in the page HTML.</p>
    </noscript>
    <h2>The factors</h2>
    <div class="table-wrap">
      <table>
        <caption>StoveRatings planning factors, BTU per hour per square foot of heated floor</caption>
        <thead>
          <tr>
            <th scope="col">Band</th>
            <th scope="col">When we mean it</th>
            <th scope="col" class="num">Low factor</th>
            <th scope="col" class="num">High factor</th>
          </tr>
        </thead>
        <tbody>
          {SIZE_BANDS.map((band) => (
            <tr>
              <th scope="row">{band.label}</th>
              <td>{bandNote(band.id)}</td>
              <td class="num">{band.low}</td>
              <td class="num">{band.high}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>Formula: low BTU/hr = square feet × low factor. High BTU/hr = square feet × high factor. The factors in the table are StoveRatings planning factors. EPA heat output on a model line is a lab range, not the heat that will arrive in the room. Source: EPA Certified Wood Heater Database, snapshot {date}. This page reads that snapshot from files on this site.</p>
    <h2 id="common-sizes">Planning ranges for common floor areas</h2>
    <p>
      Common floor areas:
      {COMMON_SIZES.map((sqft, index) => (
        <>
          {index ? ", " : null}
          <a href={`#${sizeAnchor(sqft)}`}>{formatCount(sqft)} sq ft</a>
        </>
      ))}
      .
    </p>
    <div class="table-wrap">
      <table id="size-table">
        <caption>{SIZE_TABLE_CAPTION}</caption>
        <thead>
          <tr>
            <th scope="col">Heated area</th>
            <th scope="col">Band</th>
            <th scope="col" class="num">Planning range</th>
            <th scope="col" class="num">Wood stoves</th>
            <th scope="col" class="num">Pellet stoves</th>
          </tr>
        </thead>
        <tbody>
          {sizeRows.map((row, index) => {
            const first = index === 0 || sizeRows[index - 1].sqft !== row.sqft;
            return (
              <tr>
                {first ? <th id={sizeAnchor(row.sqft)} scope="row" rowspan={bandCount}>{formatCount(row.sqft)} sq ft</th> : null}
                <th scope="row">{row.band.label}</th>
                <td class="num">{planningSpan(row.range)}</td>
                <td class="num">{formatCount(row.wood)}</td>
                <td class="num">{formatCount(row.pellet)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <h2>Questions</h2>
    {faqs.map((faq) => (
      <section>
        <h3>{faq.question}</h3>
        <p>{faq.answer}</p>
      </section>
    ))}
    <p>
      Open a model line in the <a href="/">finder</a> or the <a href="/lookup/">name lookup</a>.
      The <a href="/tools/heating-cost-calculator/">heating cost calculator</a> can turn this BTU-per-hour result into a season cost. You enter the hours. Those hours are not part of this formula.
    </p>
    <p>
      Lists ordered by an EPA figure:
      <a href="/most-efficient-wood-stoves/">wood stoves by HHV efficiency</a>,
      <a href="/most-efficient-pellet-stoves/">pellet stoves by HHV efficiency</a>,
      <a href="/cleanest-burning-wood-stoves/">wood stoves by emission rate</a>,
      <a href="/small-wood-stoves/">wood stoves with a listed firebox of 1 cubic foot or less</a>,
      and <a href="/cleanest-burning-pellet-stoves/">pellet stoves by emission rate</a>.
      Hubs: <a href="/catalytic-wood-stoves/">catalytic wood stoves</a>,
      <a href="/non-catalytic-wood-stoves/">non-catalytic wood stoves</a>,
      <a href="/hybrid-wood-stoves/">hybrid wood stoves</a>,
      and <a href="/pellet-stoves/">pellet stoves</a>.
      Insert notes on this page use the same name check as <a href="/wood-stove-inserts/">wood stove inserts</a> and <a href="/pellet-stove-inserts/">pellet stove inserts</a>.
    </p>
    <DataNote items={[
      "This sketch assumes the stove heats the whole floor area and the ceiling is about 8 feet.",
      "Insulation, layout, and a tall room change the result. A heat-loss calculation is the right tool for a purchase.",
      "StoveRatings does not sell stoves and does not set these factors from EPA data.",
      "EPA heat output is a lab test range, not delivered room heat. An overlap is a starting list, not a recommendation or a sizing guarantee.",
      "A blank heat output, HHV efficiency, or emission rate is not listed by EPA. It is not zero. Model lines with no heat-output low and high are left out, and the count is stated on this page.",
      `The overlap list is currently certified wood stoves and pellet stoves in the ${date} snapshot. Forced-air furnaces and hydronic heaters are not in that list. An insert note means the model name indicates an insert.`,
    ]} />
  </div>
</Base>
<script>
  import { mountStoveSize } from "../../lib/stove-size-ui.js";
  mountStoveSize(document);
</script>
