---
import Answer from "../components/Answer.astro";
import DataNote from "../components/DataNote.astro";
import Sections from "../components/Sections.astro";
import Base from "../layouts/Base.astro";
import { catalog } from "../lib/catalog.js";
import { formatNumber, metaDescription } from "../lib/format.js";
import { woodSubtype } from "../lib/lists.js";
import { articleLd } from "../lib/schema.js";

const groups = woodSubtype(catalog.stoves, "Catalytic Stove");
const block = catalog.stats.medians.currentWoodCatalytic;
const date = catalog.meta.snapshotDate;
const sentences = [
  `EPA lists ${block.rows} currently certified catalytic wood-stove rows in the snapshot dated ${date}.`,
  `The median emission rate of those ${block.emissionN} rows is ${formatNumber(block.emissionMedian, 2)} grams per hour.`,
  `The median HHV efficiency of those ${block.efficiencyN} rows is ${formatNumber(block.efficiencyMedian, 2)} percent.`,
  `Source: EPA Certified Wood Heater Database, snapshot ${date}.`,
];
const description = metaDescription(sentences);
---

<Base title="Catalytic wood stoves" description={description} breadcrumbs={[{ href: "/", label: "Home" }, { href: "/catalytic-wood-stoves/", label: "Catalytic wood stoves" }]} jsonLd={[articleLd("Catalytic wood stoves in the EPA list", description, "/catalytic-wood-stoves/", date)]}>
  <div class="wrap">
    <h1>Catalytic wood stoves</h1>
    <Answer sentences={sentences} />
    <p>The table groups those rows into {groups.current.length} currently certified model lines. A catalytic label is the EPA subtype, not a StoveRatings category.</p>
    <Sections sections={[
      { heading: "Currently certified", stoves: groups.current, caption: "Currently certified catalytic wood-stove model lines" },
      { heading: "Previously certified", stoves: groups.previous, caption: "Previously certified catalytic wood-stove model lines" },
    ]} />
    <p>See also <a href="/catalytic-vs-non-catalytic/">catalytic, non-catalytic, and hybrid figures</a> and <a href="/non-catalytic-wood-stoves/">non-catalytic wood stoves</a>.</p>
    <DataNote items={["Medians are calculated across EPA rows, not across model lines.", "Rows with a blank efficiency are left out of the efficiency median. The count next to each median is the number of rows that listed the figure.", "Blank cells in the table are not zeros."]} />
  </div>
</Base>
